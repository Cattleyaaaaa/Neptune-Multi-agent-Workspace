# --- 环境与密钥 -----------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ---------------------------------------------------------------
.venv/
.uv-cache/
.uv-python/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node / Next.js -------------------------------------------------------
node_modules/
.next/
.next-build/
*.tsbuildinfo
.pnpm-store/

# --- 本机专用（含 F 盘绝对路径），不要提交 --------------------------------
.npmrc
.idea/

# --- 运行时数据（SQLite、技能、写入快照都只留在本机） ---------------------
data/

# --- 临时文件与日志 --------------------------------------------------------
.cache/
.tmp/
*.log

# --- 本地文档，不上传 -------------------------------------------------------
docs/

# --- 助手工作目录（本机会话数据，不属于项目源码） --------------------------
.workbuddy/

# --- 操作系统杂项 ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
