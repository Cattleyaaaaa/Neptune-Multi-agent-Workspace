APP_CORS_ORIGINS=http://localhost:3000
# 留空时由 Next.js 通过同源 /api 代理到本地后端；上云填后端公网地址
NEXT_PUBLIC_API_URL=

# --- 推理 ---------------------------------------------------------------
APP_REASONING_PROVIDER=local
# APP_OPENAI_API_KEY=
APP_OPENAI_MODEL=gpt-5.4-mini

# --- 认证（双令牌） ------------------------------------------------------
# HS256 签名密钥，至少 32 字符；低于 32 后端启动会直接报错。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 必须设置的场景：上云（多实例/重启后要互相认得对方签的令牌）。
# 不设置时本地会生成一个随机密钥写进 SQLite，重启不丢，但只适合单机开发。
# APP_JWT_SECRET=
APP_ACCESS_TOKEN_TTL_SECONDS=1800
APP_REFRESH_TOKEN_TTL_SECONDS=86400
APP_REMEMBER_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Cookie（浏览器会话） -----------------------------------------------
# 上云（HTTPS）必须设 true；本地 http://localhost 要保持 false，否则浏览器会拒收。
APP_COOKIE_SECURE=false
# 前后端跨站部署时改成 none（必须同时 APP_COOKIE_SECURE=true）；
# 可选值 lax / strict / none
APP_COOKIE_SAMESITE=lax
# 跨子域共享会话时才需要，例如 .example.com
# APP_COOKIE_DOMAIN=
# 给不支持自定义请求头的 SSE 客户端放行 ?access_token=。默认关：令牌会进访问日志
APP_ALLOW_TOKEN_IN_QUERY=false

# 只在 Cloudflare 后面（隧道或橙云代理）打开：采信 CF-Connecting-IP 作为真实客户端 IP。
# 不打开时，注册节流会按 X-Forwarded-For 的末段计数 —— 在 CF 后面那可能是 CF 边缘地址，
# 结果是"全站共用一个配额"。反过来，不在 CF 后面却打开它 = 任何人用一个请求头就能伪造来源。
# 详见 docs/cloudflare.md 第 3.6 节。
APP_TRUST_CLOUDFLARE_IP=false

# --- 首个管理员 ----------------------------------------------------------
APP_ADMIN_USERNAME=admin
# 不设置时用内置默认值 admin123 播种，并要求登录后立即修改。上云务必显式设置。
# APP_ADMIN_PASSWORD=
APP_ADMIN_DISPLAY_NAME=工作台管理员

# --- 登录失败锁定 --------------------------------------------------------
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_LOCKOUT_SECONDS=60

# --- 浏览器里的流式地址（上云必看） --------------------------------------
# 运行中心的「进度推送」用 EventSource 直连后端；这条**不能走同源 /api 代理**，
# 因为 Next 的代理会缓冲 SSE 响应体（浏览器会永远停在 CONNECTING）。
# 不配的话前端会退化成 https://当前域名:8000 —— 域名下没有这个 TLS 端口，实时推送必然连不上。
# 同域反代：填对外地址，例如 https://nexus.example.com（反代 /api 必须关闭缓冲）
# NEXT_PUBLIC_STREAM_URL=
# 也可以直接关掉实时推送：在运行中心把「进度推送」切成「手动刷新」，就不需要这个地址。

# --- 注册与访客（上云建议都关） ------------------------------------------
# 开放注册 = 任何人都能拿到可写的 member 帐号
APP_ALLOW_REGISTRATION=true
# 访客入口 = 不注册即可只读浏览；共享演示环境很方便，对外部署建议关
APP_ALLOW_GUEST=true
# 注册按 IP 节流；进程内计数，多实例不共享
APP_REGISTRATION_LIMIT_PER_HOUR=20

# --- 数据落点 ------------------------------------------------------------
# 唯一需要持久化的东西：这个 SQLite 文件 + data/skills/ + data/snapshots/。
# 容器部署把这个目录挂卷；备份用 sqlite3 "VACUUM INTO"，别在写入中直接 cp。
APP_DATABASE_PATH=data/nexus.db

# --- 真实写入（执行适配器） ----------------------------------------------
# 文件写入的根目录，也是路径 jail 的边界；留空 = 项目根目录
APP_WRITE_ROOT=
# HTTP 写入的主机白名单（逗号分隔）；留空 = 不限制主机（内网仍会被拦）
APP_WRITE_ALLOWED_HOSTS=
# 允许写内网/回环；默认关（写接口比读接口更容易被当 SSRF 跳板）
APP_WRITE_ALLOW_PRIVATE_HOSTS=false

# --- MCP 探测 ------------------------------------------------------------
# 本机 MCP 多在 127.0.0.1，所以默认允许内网；上云建议设 false 防 SSRF
APP_MCP_ALLOW_PRIVATE_ENDPOINTS=true

# --- 注册邮箱验证（可选） -------------------------------------------------
# 填了 smtp_host/smtp_from/smtp_password 后，注册**自动变为强制验证邮箱**，
# 注册页才会出现邮箱栏与「发送验证码」。465 用隐式 SSL；587 把 starttls 打开。
# APP_SMTP_HOST=
APP_SMTP_PORT=465
# APP_SMTP_USERNAME=
# APP_SMTP_PASSWORD=
# APP_SMTP_FROM=
APP_SMTP_STARTTLS=false

# --- 向量检索（可选） -----------------------------------------------------
# local = 零依赖的本地哈希向量（离线可用）；api = 走 embedding 服务
APP_EMBEDDING_PROVIDER=local
APP_EMBEDDING_MODEL=text-embedding-3-small
APP_EMBEDDING_BASE_URL=https://api.openai.com/v1
# APP_EMBEDDING_API_KEY=
